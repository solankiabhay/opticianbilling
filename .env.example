# Configure these in the deployment environment, not in source control.
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/surya_optics?useSSL=true&serverTimezone=UTC
DB_USERNAME=surya_app
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
APP_USER=admin
APP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
LOG_FILE=logs/surya-optics.log
